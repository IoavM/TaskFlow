# TaskFlow Backend Environment Variables

# App settings
PROJECT_NAME="TaskFlow API"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-this-in-production-123456789"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Neon PostgreSQL)
# Example: postgresql://neondb_owner:password@ep-cool-flower-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# If left empty, fallback to local sqlite:///./taskflow.db for immediate offline development
DATABASE_URL="sqlite:///./taskflow.db"

# Google Gemini API Key
# Put your Gemini API Key here (from Google AI Studio)
GEMINI_API_KEY=""

# Groq API Key (from console.groq.com)
GROQ_API_KEY=""
