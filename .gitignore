# ==============================================================================
# TaskFlow .gitignore (Optimizado para Vercel, Neon PostgreSQL y FastAPI)
# ==============================================================================

# ─── Environment files & Secrets (CRÍTICO) ──────────────────────────────────
.env
.env.*
*.env
*.env.*
backend/.env
frontend/.env
*.pem
*.key
*.cert
*.crt
secrets/

# ─── Bases de Datos Locales (Producción usa Neon PostgreSQL) ────────────────
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sql
taskflow.db

# ─── Vercel Deployment & Cache ──────────────────────────────────────────────
.vercel

# ─── Dependencies ───────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Production Builds & Bundles ────────────────────────────────────────────
dist/
dist-ssr/
build/
frontend/dist/
*.tsbuildinfo

# ─── Logs ───────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Python Bytecode, Caches & Virtual Envs ─────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/
backend/.venv/
.mypy_cache/
.ruff_cache/

# ─── Editor & OS files ──────────────────────────────────────────────────────
.vscode/
**/.vscode/
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~
